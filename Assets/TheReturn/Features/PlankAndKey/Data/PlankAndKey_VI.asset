  m_Script: {fileID: 11500000, guid: 1aa70d07ea2c9b24a820ad58314aad8f, type: 3}
  m_Name: PlankAndKey_VI
  m_EditorClassIdentifier: TheReturn.PlankAndKey::TheReturn.PlankSettings
  secondsPerUnit: 3
  slackPercent: 25
  title: "C\u1EA6U V\xC1N V\xC0 TH\u1EBA T\u1EEA"
  instructions: "C\u1EA3 \u0111\u1ED9i ph\u1EA3i qua khe sang b\u1EDD b\xEAn kia.
    V\xE1n ch\u1EC9 ch\u1EDF t\u1ED1i \u0111a 2 ng\u01B0\u1EDDi v\xE0 ch\u1EC9 h\u1EA1
    xu\u1ED1ng khi c\xF3 th\u1EBB t\u1EEB tr\xEAn v\xE1n, n\xEAn ph\u1EA3i c\xF3
    ng\u01B0\u1EDDi mang th\u1EBB quay v\u1EC1 \u0111\xF3n nh\u1EEFng ng\u01B0\u1EDDi
    c\xF2n l\u1EA1i. M\u1ED7i l\u01B0\u1EE3t t\u1ED1n th\u1EDDi gian c\u1EE7a ng\u01B0\u1EDDi
    ch\u1EADm h\u01A1n. H\u1EBFt th\u1EDDi gian th\xEC c\u1EA3 \u0111\u1ED9i v\u1EC1
    \u0111\u1EA7u khe."
  failure: "H\u1EBFt th\u1EDDi gian! C\u1EA3 \u0111\u1ED9i v\u1EC1 \u0111\u1EA7u
    khe. H\xE3y th\u1EED l\u1EA1i."
  success: "C\u1EA3 \u0111\u1ED9i \u0111\xE3 qua khe! \u0110\xE3 ho\xE0n th\xE0nh
    C\u1EA7u v\xE1n v\xE0 th\u1EBB t\u1EEB."
  waiting: "C\u1EA3 \u0111\u1ED9i \u0111\u1EE9ng \u0111\u1EE7 \u1EDF v\xF9ng chu\u1EA9n
    b\u1ECB \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u."
