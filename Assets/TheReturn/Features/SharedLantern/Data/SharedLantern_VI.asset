    \u0111\u01B0\u1EE3c."
  readAlready: "B\u1EA1n \u0111\xE3 \u0111\u1ECDc bi\u1EC3n n\xE0y r\u1ED3i."
  passed: "\u0110\xE3 trao \u0111\xE8n l\u1ED3ng."
  passTooFar: "Ng\u01B0\u1EDDi nh\u1EADn \u1EDF qu\xE1 xa \u0111\u1EC3 trao \u0111\xE8n."
  passNotHolder: "Ch\u1EC9 ng\u01B0\u1EDDi \u0111ang c\u1EA7m \u0111\xE8n m\u1EDBi
